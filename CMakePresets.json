{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "debug",
            "displayName": "Debug with realtime audio",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "BUILD_TESTS": "ON",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "debug-tests",
            "displayName": "Debug with tests (no realtime audio)",
            "inherits": "debug",
            "cacheVariables": {
                "NO_REALTIME_AUDIO": "ON"
            }
        },
        {
            "name": "coverage",
            "displayName": "Release with tests and coverage (GCC only)",
            "inherits": "debug-tests",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "TRACK_COVERAGE": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "configuration": "Debug"
        },
        {
            "name": "debug-tests",
            "configurePreset": "debug-tests",
            "configuration": "Debug"
        },
        {
            "name": "coverage",
            "configurePreset": "coverage",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "debug-tests",
            "configurePreset": "debug-tests",
            "configuration": "Debug",
            "output": {
                "outputOnFailure": true,
                "maxPassedTestOutputSize": 10000000,
                "maxFailedTestOutputSize": 10000000
            }
        },
        {
            "name": "coverage",
            "configurePreset": "coverage",
            "configuration": "Release",
            "output": {
                "outputOnFailure": true,
                "maxPassedTestOutputSize": 10000000,
                "maxFailedTestOutputSize": 10000000
            }
        }
    ]
}
